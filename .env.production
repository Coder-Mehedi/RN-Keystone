# Loaded for production bundles (store builds, over-the-air updates). Committed: nothing secret
# may live here. Anything prefixed EXPO_PUBLIC_ is written into the JavaScript bundle in plain
# text.
#
# The real API URL is set per environment in Expo Services (Expo Build and Expo Update read it
# from there), so it is intentionally left empty in this file.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_MOCK=false
